# ─────────────────────────────────────────────────────────────────────────────
# MammoAI — muhit o'zgaruvchilari
#
# SEC-02 (2026-09-22): bu fayl ilgari faqat 3 ta o'zgaruvchini sanardi,
# holbuki kodda 7 tasi ishlatiladi. Natijasi jim va xavfli edi: `CRON_SECRET`
# bu yerda yo'qligi uchun uni Vercel'da sozlash kerakligini hech kim bilmasdi,
# kunlik eslatmalar endpoint'i esa "secret bo'lmasa tekshirmaydi" tarzda
# yozilgan edi — ya'ni butunlay ochiq qolishi mumkin edi.
#
# Qoida: kodga yangi `process.env.X` qo'shsangiz, SHU YERGA ham yozing.
# ─────────────────────────────────────────────────────────────────────────────

# ── Majburiy ────────────────────────────────────────────────────────────────

# Supabase loyihangiz: Project Settings → Database → Connection string →
# "Transaction pooler" (odatda 6543-port) — serverless/Vercel uchun shu kerak.
DATABASE_URL=postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Sessiya JWT imzosi uchun sir — lokal dev'da avtomatik yaratiladi (.env.local),
# lekin Vercel (production)da bu qatorni albatta o'zingiz muhit o'zgaruvchisi
# sifatida qo'shishingiz kerak (aks holda har "cold start"da yangi tasodifiy sir
# yaratiladi va barcha sessiyalar tez-tez uzilib qoladi).
SESSION_SECRET=

# Admin panel (/admin) — bitta umumiy parol. O'zingiz tanlagan kuchli qiymatni
# qo'ying (lokal .env.local'ga ham, Vercel muhit o'zgaruvchilariga ham).
ADMIN_PASSWORD=

# Kunlik eslatmalar cron'i (/api/cron/daily-reminders) uchun sir.
# MUHIM: sozlanmagan bo'lsa endpoint ISHLAMAYDI (503 qaytaradi) — bu ataylab.
# Ilgari u ochiq qolardi va istalgan odam barcha foydalanuvchilarga Telegram
# xabar yuborishi mumkin edi. Vercel cron so'rovga avtomatik
# `Authorization: Bearer <CRON_SECRET>` sarlavhasini qo'shadi.
CRON_SECRET=

# ── Ixtiyoriy ───────────────────────────────────────────────────────────────

# Admin sessiyasi uchun alohida sir. Berilmasa SESSION_SECRET ishlatiladi.
ADMIN_SESSION_SECRET=

# Homiladorlik albomi rasmlarini saqlash (@vercel/blob). Vercel loyihasida
# Blob do'koni ulansa, bu o'zgaruvchi AVTOMATIK qo'shiladi — qo'lda yozish
# faqat lokal dev uchun kerak.
BLOB_READ_WRITE_TOKEN=

# Yandex Metrica hisoblagichi (analitika). Bo'sh bo'lsa skript yuklanmaydi.
NEXT_PUBLIC_YANDEX_METRICA_ID=

# ── Bu yerda YO'Q, lekin kerak bo'ladigan narsalar ──────────────────────────
#
# Telegram bot tokeni va AI provayder kaliti ATAYLAB muhit o'zgaruvchisi
# EMAS — ular `app_settings` jadvalida saqlanadi va admin panel orqali
# kiritiladi (yangi Vercel env var qo'shmasdan almashtirish mumkin bo'lsin
# uchun). Qarang: src/server/telegram-bot.ts
#
# VERCEL_* o'zgaruvchilarini (VERCEL_ENV, VERCEL_GIT_COMMIT_SHA va h.k.)
# Vercel o'zi beradi — qo'lda sozlash shart emas.
