{
  "name": "mammoai-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "build:web": "npm run build --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=packages/shared && npm run typecheck --workspace=apps/web",
    "test": "npm run test --workspace=packages/shared",
    "seed": "npm run seed --workspace=apps/web"
  }
}
